NOTION_TOKEN=
CONTEXT_ROOM_NOTION_TOKEN=
CONTEXT_ROOM_NOTION_SESSIONS_DATA_SOURCE_ID=2408cbf8-c394-4d33-927b-df0f2bea0594
ACCESS_KEY=
# 「今天」、晨間啟動與晚間收光使用的當地時區。
NEXT_PUBLIC_DOJO_TIME_ZONE=Asia/Taipei
VOCABFORGE_INTEGRATION_URL=
LUMEN_VOCABFORGE_SYNC_SECRET=
# 語境修習室入口；未設定時使用正式站預設網址。
CONTEXT_ROOM_URL=https://lumen-context-room-production-4a2c.up.railway.app
# 行光道場 → 語境修習室的伺服器派送；兩邊必須設定相同的隨機密鑰。
CONTEXT_ROOM_INTEGRATION_URL=https://lumen-context-room-production-4a2c.up.railway.app
LUMEN_CONTEXT_ROOM_SYNC_SECRET=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 僅允許這個 LINE user ID 寫入私人剪藏入口。
LINE_ALLOWED_USER_ID=
# 財富豐盛記錄本服務端網址與獨立 S2S 密鑰；不與 LINE 或登入密鑰共用。
LUMINARA_WEALTH_URL=
LUMINARA_WEALTH_APP_URL=
LUMINARA_WEALTH_S2S_SECRET=
# Explicit rollout boundary. When false/unset, ordinary LINE images never call Luminara.
LUMINARA_WEALTH_BANK_ENABLED=false
OPENAI_API_KEY=
# 英文影像辨識預設使用 GPT-5.6 Luna；可在 Railway 覆寫。
OPENAI_ENGLISH_IMAGE_MODEL=gpt-5.6-luna
# 只計算本功能已記錄的估算費用；仍建議同時在 OpenAI Project 設定預算警示。
OPENAI_ENGLISH_IMAGE_MONTHLY_BUDGET_USD=2

# R2-1: absolute path on a durable shared POSIX volume, one owner/database per directory.
# All instances writing learning/capture data must run this version and share this path.
# Leave unset to disable new foundation/legacy-editor writes (503). Never use /tmp in production.
LEARNING_WRITE_LOCK_DIR=
