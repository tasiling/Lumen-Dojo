import {assertPlatformProvenance} from '@/lib/dojo/creativeStudio/model';
// File-preview transport. The UI and pure validation/instruction modules are the draft's actual code.
// This local adapter deliberately has no production database, credentials, AI or publishing connection.
import {blankStudio,normalizeStudio,studioForWork,newDirection,mergeCandidateDirection} from '@/lib/dojo/creativeStudio/model';
import {manuscriptForAdoption,recordRound,instructionsForSource,cBase} from '@/lib/dojo/creativeStudio/collaboration';
import {importPreview,importDigest,prototypePageText} from '@/lib/dojo/creativeStudio/migration';
import {importReport} from '@/lib/dojo/creativeStudio/importPlan';
import {nativeDirection} from '@/lib/dojo/creativeStudio/directionMapping';
import {taskContext,taskStatus} from '@/lib/dojo/creativeStudio/tasks';
import {prototypeGraphics} from '@/lib/dojo/creativeStudio/graphicsMigration';
import {createWorkDraft,createShuttleDraft} from '@/lib/dojo/weavingShuttle';
import {createTextWorkflow} from '@/lib/dojo/weavingWorkflow/templates';
import {randomID,sha256Text} from '@/lib/dojo/weavingWorkflow/clientIdentity';
import {newPage,parseDeckDraft,assertReady} from '@/lib/dojo/illustrated/model';
import {parseReleasePatch} from '@/lib/dojo/creativeReleases/model';
import {adaptSource} from '@/lib/dojo/liaojieText/model';

const KEY='lumen-creative-draft-html-pr114-v1';
const now=()=>new Date().toISOString(),clone=(v:any)=>structuredClone(v),id=()=>randomID();
const empty=()=>({schema:1,works:[],topics:[],looseDirections:[],sources:[],policies:{},completions:[],decks:[],assets:{},transfers:[],projects:[],variants:[],releases:[],operations:{},voice:{id:'local-voice',revision:1,samples:[],proposal:'',confirmed:false}} as any);
let state:any;let storageOK=true,failedSave=false;
try{const saved=localStorage.getItem(KEY);state=saved?JSON.parse(saved):empty();if(state.schema!==1)state=empty()}catch{state=empty();storageOK=false}
function ensureState(){state.looseDirections ||= [];state.sources ||= [];state.policies ||= {};for(const w of state.works)w.studio=studioForWork(w);if(!state.sources.length)state.sources=[{sourceType:'forage_capture',sourceId:'preview-raw-clip',label:'示例｜還沒形成觀點的剪藏',locator:'示例剪藏 · 第1段',contentKind:'insight',text:'今天走回家的路上，我注意到樹影在牆上慢慢移動。\n\n我還不知道想說什麼，只想先保留這個觀察。',version:'explore-source:demo-raw-v1',availability:'available',maturity:'C0'}];}
ensureState();
export const snapshot=()=>clone(state);
export const previewAssetURL=(key:string)=>state.assets[key]||'';
function persist(){try{localStorage.setItem(KEY,JSON.stringify(state));storageOK=true}catch{storageOK=false}dispatchEvent(new Event('preview-state'))}
export function storageStatus(){return storageOK}
export function failNextSave(){failedSave=true;dispatchEvent(new Event('preview-state'))}
export function replaceSnapshot(s:any){if(s?.kind!=='lumen-creative-draft-preview'||s?.state?.schema!==1||!Array.isArray(s.state.works)||!Array.isArray(s.state.completions))throw Error('請選這份 HTML 下載的完整備份；舊測試版 JSON 請從「舊資料預覽與匯入」讀取。');state=clone(s.state);ensureState();persist();dispatchEvent(new HashChangeEvent('hashchange'))}
export function fullBackup(){return{kind:'lumen-creative-draft-preview',schema:1,sourcePR:114,exportedAt:now(),state:snapshot()}}
export function resetDemo(){state=empty();ensureState();seed();persist();location.hash='/weaving?example='+Date.now();dispatchEvent(new HashChangeEvent('hashchange'))}
function must<T>(value:T|undefined,message='找不到這份資料'):T{if(!value)throw Error(message);return value}
function work(id:string){return must<any>(state.works.find((w:any)=>w.id===id),'找不到作品')}
function completion(id:string){return must<any>(state.completions.find((c:any)=>c.id===id),'請選本件固定完稿')}
function expect(row:any,revision:any){if(row.revision!==revision){const error:any=Error('資料版本已變更，請比較目前保存版本');error.status=409;throw error}}
function digest(w:any){return sha256Text(JSON.stringify(w))}
function bundle(w:any){return{work:clone(w),completions:clone(state.completions.filter((c:any)=>c.workId===w.id).sort((a:any,b:any)=>b.createdAt.localeCompare(a.createdAt))),previewDigest:digest(w)}}
function workflow(s:any,previous?:any){const wf=previous?.textWorkflow||createTextWorkflow('article');return{...wf,blocks:[{id:'studio-body',role:'正文',text:s.body,mediaNote:''}],sourceSelections:wf.sourceSelections?.length?wf.sourceSelections:s.source.selected?[{sourceType:'manual',sourceId:'preview-owner',sourceVersion:s.source.selectedVersion,locator:s.source.title||'本次選摘',contentKind:'experience',selectedText:s.source.selected,capturedAt:now(),digest:sha256Text(s.source.selected)}]:[]}}
function create(title:string,s=blankStudio(),extra:any={}){const w={...createWorkDraft({title,shuttleId:extra.shuttleId||'',coreVersionId:s.direction?.versionId||'unassigned',format:'text',studio:s}),id:id(),revision:1,studio:clone(s),draftText:s.body,textWorkflow:workflow(s),...extra};state.works.push(w);return w}
function touch(w:any){w.revision++;w.updatedAt=now();w.draftText=w.studio.body;w.textWorkflow=workflow(w.studio,w);return w}
function fix(w:any,title=w.title){const c={schemaVersion:1,id:id(),owner:'dojo-private-owner',workId:w.id,operationId:'preview-'+id(),coreVersionId:w.coreVersionId,sourceSelections:clone(w.textWorkflow.sourceSelections),sourceSnapshotState:'captured',outputKind:w.studio.contentKind==='illustrated'?'carousel_copy':'article',text:w.studio.body,title,createdAt:now(),outputUrl:'',state:'confirmed',supersededBy:null,studioSnapshot:clone(w.studio)};state.completions.push(c);w.completionVersionRefs.push(c.id);w.currentCompletionVersionId=c.id;w.status='completed';w.completedAt=c.createdAt;touch(w);return c}
function seed(){
 const t={...createShuttleDraft({title:'生活裡的觀察',coreStatement:'從生活素材慢慢找回想表達的意思',sourceType:'manual',sourceSnapshot:''}),id:id(),revision:1,studioDirections:[newDirection('demo-direction','給想法留一點空間','把零散觀察留下來，也能慢慢長成作品。','demo-understanding',now())]};state.topics.push(t);
 const s=blankStudio();s.source={...s.source,title:'示例｜生活觀察',raw:'今天我把一段零散的想法寫了下來。\n\n還沒有完整答案，但我想先保留那個讓我停下來的瞬間。',selected:'今天我把一段零散的想法寫了下來。\n\n還沒有完整答案，但我想先保留那個讓我停下來的瞬間。',allowAI:true,allowPublic:false};s.collaboration.aIntent='我想看看，一段還沒有結論的觀察，可以怎麼成為作品。';s.collaboration.aAnswers='這是示例素材。我想保留慢慢探索的感覺，不急著給讀者答案。';
 s.a='我們可以保留兩條不同方向，再由你決定。\n\n```json\n'+JSON.stringify({candidates:[{title:'先把一個瞬間留下來',understanding:'從一個具體觀察開始，不急著補成結論。',originalQuote:'我想先保留那個讓我停下來的瞬間。',quoteLocator:'示例素材第2段'},{title:'還沒想清楚也可以寫',understanding:'把暫定理解寫下來，讓後續討論有地方接續。',originalQuote:'還沒有完整答案',quoteLocator:'示例素材第2段'}]})+'\n```';
 s.b='## 討論回覆\n先寫成一篇短的個人觀察。\n## 研究參考\n```json\n[{"title":"可再查核的研究方向","source":"","mechanism":"","scope":"尚未查核，先不作結論","relation":"思考記錄與創作的關聯"}]\n```\n## 例子提案\n```json\n[{"kind":"hypothetical","text":"假設有人只記下一句觀察，下一次再回來補充。","source":"示範用假設"}]\n```\n## 編輯說明\n保留作者尚未有答案的狀態，不把研究自動放入正文。\n## 候選主文\n給想法留一點空間\n\n今天，我把一段零散的想法寫了下來。\n\n它還不是答案，也還沒有整理成完整的文章。只是某個觀察讓我停下來，我想先把那個瞬間留下。\n\n也許下一次回來看，我會有不同的理解。現在，我想先給這個想法一點空間。';
 create('示例｜從素材到一篇文章',s,{shuttleId:t.id});
 const g=blankStudio();g.contentKind='illustrated';g.body='先把一個想法留下\n\n有些觀察還沒有答案，也值得先給它一個位置。';g.source={...g.source,title:'示例｜圖文原稿',raw:g.body,selected:g.body,allowAI:true,allowPublic:true};g.collaboration.aAnswers='這份示例想保留觀察，不要求馬上得出結論。';g.checks={facts:true,privacy:true,citations:true,voice:true};
 const layouts=['blank','photo','dialogue','magazine','arch'];g.legacy={data:{format:'illustrated',pages:layouts.map((layout,i)=>({layout,size:i===4?'story':'portrait',title:['先把一個想法留下','一段生活觀察','留一點討論的空間','把零散想法排成作品','之後，再回來看'][i],body:'有些觀察還沒有答案，\n也值得先給它一個位置。',brand:'草稿示例',footer:i===1?'':'全零的創作工作台',text:{title:{x:10,y:22,width:80,size:60,lineHeight:1.4,align:'left'},body:{x:10,y:45,width:80,size:36,lineHeight:1.6,align:'left'}}}))}};
 const w=create('示例｜五種舊圖文版型',g);fix(w);
}
if(!state.works.length){seed();persist()}
export function demoWork(){return state.works.find((w:any)=>w.title==='示例｜從素材到一篇文章')?.id||state.works[0]?.id}
export function demoGraphicWork(){return state.works.find((w:any)=>w.title==='示例｜五種舊圖文版型')?.id}

function deck(id:string){return must<any>(state.decks.find((d:any)=>d.deck.id===id),'找不到圖文稿')}
function newDeck(c:any){const prior=state.decks.find((b:any)=>b.deck.completionId===c.id);if(prior)return prior;const deckId=id(),v={id:id(),deckId,number:1,title:c.title,caption:'',pages:[{...newPage('page-'+id()),title:c.title.length<=120?c.title:''}],createdAt:now()};const d={deck:{id:deckId,owner:'dojo-private-owner',revision:1,completionId:c.id,workId:c.workId,sourceDigest:sha256Text(c.text),currentVersionId:v.id,versionRefs:[v.id],outputRefs:[],createdAt:now(),updatedAt:now()},version:v,versions:[v],outputs:[]};state.decks.push(d);return d}
function saveDeck(d:any,draft:any){const v={...parseDeckDraft(draft),id:id(),deckId:d.deck.id,number:d.versions.length+1,createdAt:now()};d.version=v;d.versions.unshift(v);d.deck.currentVersionId=v.id;d.deck.versionRefs.push(v.id);d.deck.revision++;return d}
function graphicPreview(w:any,choice:string,completionId=''){const data=w.studio.legacy?.data||{},old=choice==='draft'?data:(data.versions||[]).find((v:any)=>v.id===choice);if(!old)throw Error('找不到舊圖文配置');if(completionId&&completion(completionId).workId!==w.id)throw Error('請選本件固定完稿');const p=prototypeGraphics(old.title||w.title,old.pages),existing=state.decks.find((d:any)=>d.deck.completionId===completionId);return{...p,options:[],existingDeck:existing?{id:existing.deck.id,revision:existing.deck.revision}:null}}
function projectFor(c:any,w:any,realm='weaving'){let p=state.projects.find((p:any)=>p.sourceCompletionVersionId===c.id);if(p)return p;p={sourceReturnRealm:realm,id:id(),revision:1,weavingShuttleId:w.shuttleId,weavingWorkId:w.id,sourceCompletionVersionId:c.id,sourceCoreVersionId:c.coreVersionId,sourceFormat:'text',sourceTitle:c.title,sourceCoreStatement:c.studioSnapshot?.direction?.statement||c.studioSnapshot?.collaboration?.aAnswers||'本件固定原稿',sourceDraftSnapshot:c.text,sourceOutputUrl:'',title:c.title,audience:'',brandAngle:'',platform:'plurk',coverCopy:'',summary:'',callToAction:'',themeGroup:'',scheduledOn:null,status:'received',publishedUrl:'',responseNote:'',nextStep:'',illustratedOutputRefs:[],shortVideoOutputRefs:[],videoOutputRefs:[],podcastOutputRefs:[],comicOutputRefs:[],longVideoOutputRefs:[],createdAt:now()};state.projects.push(p);return p}
function versionSource(c:any){return{kind:'text',id:c.id,format:'text',title:c.title,versionId:c.id,platform:null}}
function releasedCandidates(publicationId?:string){const ps=state.projects.filter((p:any)=>!publicationId||p.id===publicationId);return ps.flatMap((p:any)=>{const c=state.completions.find((c:any)=>c.id===p.sourceCompletionVersionId);return c?[versionSource(c),...state.variants.filter((b:any)=>b.variant.publicationId===p.id&&b.variant.status!=='draft').map((b:any)=>({kind:'platform-text',id:b.currentVersion.id,format:'text',title:b.currentVersion.title,versionId:b.currentVersion.id,versionNumber:b.currentVersion.number,platform:b.variant.platform}))]:[]})}
export function migrationExample(){return {kind:'lumen-weaving-flow-prototype',schema:1,state:{sources:[],shuttles:[],directions:[{id:'example-loose',shuttleId:null,title:'示例｜未歸屬的方向',question:'一個觀察可以保留多久？',angle:'生活裡的留白',versions:[{id:'example-direction-v1',statement:'先留下觀察，不急著找結論。',createdAt:'2026-10-01'},{id:'example-direction-v2',statement:'保留前一次理解，也容許下一次改變。',createdAt:'2026-10-02'}]}],workSessions:[{id:'example-migration-work',data:{title:'示例｜舊稿功能搬遷',draft:'這是舊版的目前草稿，尚未採用新的 AI 改寫。',intent:'我想保留觀察的過程。',question1:'不急著給讀者答案。',question2:'從一個真實瞬間開始。',draftHistory:['第一份草稿：一個瞬間。','第二份草稿：替瞬間留一點空間。'],handoffId:'example-old-fixed',platformDrafts:{plurk:'舊噗浪配文：先把想法留下。',ig:'舊 IG 配文：讓觀察有地方接續。',threads:'舊 Threads 配文：現在沒有答案也可以寫。'},publicationHistory:[{platform:'plurk',url:'https://example.org/demo-post',publishedAt:'2026-10-03 18:30',zone:'Australia/Melbourne',versionId:'example-old-fixed'}],versions:[{id:'example-old-fixed',format:'text',title:'示例舊完成版',body:'先把一個瞬間留下，也給下一次理解一個起點。'}],spoken:'這是仍只封存的聲音文本，不能冒稱已完成轉製。'}}]}}}
function applyImport(packet:any,planDigest?:string){
 const p=importReport(packet,state.works,state.looseDirections,state.completions),ids:string[]=[];if(planDigest&&p.planDigest!==planDigest)throw Error('預覽後資料已變更，請重新預覽新建／接續對照');if(p.kind!=='html')throw Error('這類備份請從原工具入口還原。');
 const old=packet.state||packet,map=new Map<string,string>();
 for(const topic of old.shuttles||[]){const dirs=(old.directions||[]).filter((d:any)=>d.shuttleId===topic.id),identity=importDigest({topic,directions:dirs});let t=state.topics.find((t:any)=>t.studioImportIdentity===identity);if(!t){t={...createShuttleDraft({title:topic.title||'匯入主題',coreStatement:topic.title||'匯入主題',sourceType:'manual',sourceSnapshot:''}),id:id(),revision:1,studioImportIdentity:identity,studioDirections:dirs.map(nativeDirection)};state.topics.push(t)}map.set(topic.id,t.id)}
 for(const d of (old.directions||[]).filter((d:any)=>!(old.shuttles||[]).some((t:any)=>t.id===d.shuttleId))){const identity=importDigest(d);if(!state.looseDirections.some((x:any)=>x.identity===identity))state.looseDirections.push({id:id(),revision:1,identity,direction:nativeDirection(d),assignedTo:''})}
 for(const x of p.works){const native=x.studio.legacy?.nativeWork as any;let w=state.works.find((w:any)=>w.studio.importIdentity===x.identity||w.id===native?.id);
  if(w){if(!native&&w.studio.legacy?.migrationVersion!==2){const f=w.studio;if(!f.collaboration.aAnswers.trim())f.collaboration.aAnswers=x.studio.collaboration.aAnswers;for(const key of ['history','platformDrafts','publicationHistory'])f[key].push(...(x.studio as any)[key].filter((h:any)=>!f[key].some((n:any)=>n.id===h.id)));f.legacy.migrationVersion=2;touch(w)}}
  else w=create(x.title,clone(x.studio),{...(native?{status:native.status,derivedFromWorkId:native.derivedFromWorkId}:{}),shuttleId:map.get(x.shuttleId||'')||native?.shuttleId||'',...(x.selections?{textWorkflow:{...createTextWorkflow('article'),sourceSelections:clone(x.selections)}}:{})});
  const data=x.studio.legacy?.data as any;
  for(const old of data?.versions||[]){if(state.completions.some((c:any)=>c.workId===w.id&&c.originalVersionId===old.id))continue;if(old.format&&old.format!=='text'&&old.format!=='illustrated')continue;const s=old.studioSnapshot?normalizeStudio(old.studioSnapshot):clone(w.studio);s.body=old.body||old.text||(old.format==='illustrated'?prototypePageText(old.pages):'');if(!s.body.trim())continue;s.source={...s.source,allowAI:false,allowPublic:false};const c={schemaVersion:1,id:id(),owner:'dojo-private-owner',workId:w.id,operationId:'preview-import-'+id(),coreVersionId:old.coreVersionId||s.direction?.versionId||'unassigned',sourceSelections:clone(old.sourceSelections||[]),sourceSnapshotState:'captured',outputKind:old.format==='illustrated'?'carousel_copy':'article',text:s.body,title:old.title||w.title,createdAt:old.createdAt||now(),state:'confirmed',supersededBy:null,outputUrl:'',studioSnapshot:s,originalVersionId:old.id};state.completions.push(c);w.completionVersionRefs.push(c.id);w.currentCompletionVersionId=c.id;}
  for(const draft of [...w.studio.platformDrafts,...w.studio.publicationHistory]){const c=state.completions.find((c:any)=>c.workId===w.id&&c.originalVersionId===draft.sourceVersionId);if(c)draft.sourceVersionId=c.id}
  if(native?.currentCompletionVersionId){const c=state.completions.find((c:any)=>c.workId===w.id&&c.originalVersionId===native.currentCompletionVersionId);if(c)w.currentCompletionVersionId=c.id;}
  w.studio.analyses=w.studio.analyses.map((a:any)=>{if(state.completions.some((c:any)=>c.id===a.completionId&&c.workId===w.id))return a;const c=state.completions.find((c:any)=>c.workId===w.id&&c.originalVersionId===a.completionId&&c.text===a.sourceText&&c.coreVersionId===a.coreVersionId);if(!c)throw Error('D 分析的原完成版無法核對；請保留備份。');return{...a,completionId:c.id}});ids.push(w.id)
 }return{workIds:ids,warnings:p.warnings}
}
function sourceContext(s:any){const cb=cBase(s.collaboration),fixed=state.completions.find((c:any)=>c.id===cb.versionId);return taskContext(s,fixed?.studioSnapshot)}

async function handle(u:URL,method:string,b:any,rawBody:any):Promise<any>{
 const path=u.pathname,q=u.searchParams;
 if(path==='/api/dojo/creative-studio'){
  if(method==='GET'){
   if(q.has('graphics'))return graphicPreview(work(q.get('id')!),q.get('choice')||'draft',q.get('completionId')||'');
   if(q.has('deckId'))return{transfers:state.transfers.filter((t:any)=>t.deckId===q.get('deckId'))};
   if(q.has('id'))return bundle(work(q.get('id')!));
   if(q.has('operationId'))return{receipt:null,observations:{}};
   return{works:state.works.filter((w:any)=>q.has('includeArchived')||w.status!=='archived'),topics:state.topics,looseDirections:state.looseDirections.filter((d:any)=>!d.assignedTo)};
  }
  if(b.action==='create')return{work:create(b.title||'未命名探索草稿',b.studio?normalizeStudio(b.studio):blankStudio(),{shuttleId:b.shuttleId||''})};
  if(b.action==='topic'){const t={...createShuttleDraft({title:b.title,coreStatement:b.title,sourceType:'manual',sourceSnapshot:''}),id:id(),revision:1,studioDirections:[]};state.topics.push(t);return{topic:t}}
  if(b.action==='directions'){const t=must<any>(state.topics.find((x:any)=>x.id===b.id));expect(t,b.expectedRevision);t.studioDirections=clone(b.directions);t.revision++;return{topic:t}}
  if(b.action==='import-preview')return{preview:importReport(b.packet,state.works,state.looseDirections,state.completions)};
  if(b.action==='import')return applyImport(b.packet,b.planDigest);
  if(b.action==='canva'){const d=deck(b.deckId);expect(d.deck,b.expectedRevision);if(!b.externalConfirmed||d.version.id!==b.versionId)throw Error('請核對外部使用與目前圖文版本');if(b.designUrl&&!/^https:\/\/(?:www\.)?canva\.com\//.test(b.designUrl))throw Error('請填完整 Canva 設計網址');const t={id:id(),revision:1,deckId:b.deckId,versionId:b.versionId,completionId:d.deck.completionId,title:d.version.title,pages:clone(d.version.pages),designUrl:b.designUrl,resultUrl:'',note:'',createdAt:now()};state.transfers.push(t);return{transfer:t}}
  if(b.action==='canva-result'){const t=must<any>(state.transfers.find((t:any)=>t.id===b.id));expect(t,b.expectedRevision);if(!/^https?:\/\//.test(b.resultUrl))throw Error('請填完整成品連結');Object.assign(t,{resultUrl:b.resultUrl,note:b.note,revision:t.revision+1});return{transfer:t}}
  if(b.action==='loose-direction'){const row=must<any>(state.looseDirections.find((d:any)=>d.id===b.id));expect(row,b.expectedRevision);if(row.assignedTo)throw Error('方向已歸屬');for(const v of row.direction.versions)if(!b.direction.versions.some((n:any)=>JSON.stringify(n)===JSON.stringify(v)))throw Error('已保存的理解不可改寫');const topic=b.topicId?must<any>(state.topics.find((t:any)=>t.id===b.topicId)):null;if(topic){expect(topic,b.expectedTopicRevision);if(topic.studioDirections.some((d:any)=>d.id===b.direction.id))throw Error('方向已存在');topic.studioDirections.push(clone(b.direction));topic.revision++}row.direction=clone(b.direction);row.revision++;row.assignedTo=topic?.id||'';return{loose:row,topic}}
  const w=work(b.id),s=w.studio;expect(w,b.expectedRevision??w.revision);
  if(b.action==='save'){
   if(failedSave){failedSave=false;throw Error('示例：本次保存失敗，輸入保留；可按保存重試。')}
