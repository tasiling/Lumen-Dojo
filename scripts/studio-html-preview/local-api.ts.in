const fetchNative=window.fetch.bind(window);
window.fetch=async(input:any,init:any={})=>{
 const rawURL=typeof input==='string'?input:input?.url||String(input),u=new URL(rawURL,'https://preview.invalid');
 if(!u.pathname.startsWith('/api/dojo/')){if(/^(blob:|data:)/.test(rawURL))return fetchNative(rawURL,init);throw Error('模擬 HTML 不會自動連接外部網站')}
 const method=init.method||'GET',raw=init.body,b=typeof raw==='string'?JSON.parse(raw):{};
 try{const key=b.operationId&&b.action!=='import-preview'?u.pathname+':'+b.operationId:'',hash=sha256Text(JSON.stringify(b));if(key&&state.operations[key]){const prior=state.operations[key];if(prior.hash!==hash)throw Error('同一保存操作的內容不同');return new Response(JSON.stringify(prior.value),{headers:{'content-type':'application/json'}})}const backup=method!=='GET'?clone(state):null;let value:any;try{value=await handle(u,method,b,raw)}catch(e){if(backup)state=backup;throw e}if(value instanceof Response)return value;value=clone(value);if(method!=='GET'){if(key)state.operations[key]={hash,value};persist()}return new Response(JSON.stringify(value),{headers:{'content-type':'application/json'}})}catch(e:any){return new Response(JSON.stringify({error:e.message||String(e)}),{status:e.status||400,headers:{'content-type':'application/json'}})}
};

// File URLs have no server; turn explicit image downloads into the matching local asset.
document.addEventListener('click',(event)=>{const a=(event.target as Element)?.closest?.('a[download]') as HTMLAnchorElement|null;const href=a?.getAttribute('href')||'';if(!a||!href.startsWith('/api/dojo/illustrated/assets'))return;const key=new URL(href,'https://preview.invalid').searchParams.get('id')||'',data=previewAssetURL(key);if(data)a.href=data;},true);
