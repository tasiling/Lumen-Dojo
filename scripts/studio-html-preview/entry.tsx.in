import React,{useState,useEffect}from'react';
import{createRoot}from'react-dom/client';
import './local-api';
import{fullBackup,replaceSnapshot,resetDemo,storageStatus,failNextSave,demoWork,demoGraphicWork,snapshot,migrationExample}from'./local-api';
import{usePathname,useSearchParams,Link,navigate}from'./router';
import StudioHome from '@/app/components/creativeStudio/StudioHome';
import StudioManager from '@/app/components/creativeStudio/StudioManager';
import StudioWorkspace from '@/app/components/creativeStudio/StudioWorkspace';
import StudioTopics from '@/app/components/creativeStudio/StudioTopics';
import StudioImport from '@/app/components/creativeStudio/StudioImport';
import SourceSettingsWorkspace from '@/app/components/creativeSources/SourceSettingsWorkspace';
import StudioVoice from '@/app/components/creativeStudio/StudioVoice';
import IllustratedWorkspace from '@/app/components/illustrated/IllustratedWorkspace';
import LiaojiePublicationWorkbench from '@/app/components/LiaojiePublicationWorkbench';
import ReleaseHistory from '@/app/components/creativeReleases/ReleaseHistory';
import ToolHub from '@/app/components/liaojieTools/ToolHub';
import OriginalToolWorkspace from '@/app/components/liaojieTools/OriginalToolWorkspace';
import{originalTool}from'@/lib/liaojieTools/catalog';
import CreativeIcon from '@/app/components/creative/CreativeIcon';
import CreativeHeroArt from '@/app/components/creative/CreativeHeroArt';

function download(){const a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify(fullBackup(),null,2)],{type:'application/json'}));a.href=url;a.download='lumen-creative-preview-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),30000)}
class Boundary extends React.Component<any,{error:string}>{state={error:''};static getDerivedStateFromError(e:any){return{error:e.message||String(e)}}render(){return this.state.error?<section className="preview-error"><h1>這個畫面暫時無法開啟</h1><p>{this.state.error}</p><button onClick={()=>{this.setState({error:''});navigate('/weaving')}}>回織光堂</button><button onClick={download}>下載目前預覽備份</button></section>:this.props.children}}
function Toolbar({realm}:{realm:string}){const[notice,setNotice]=useState(''),[persistent,setPersistent]=useState(storageStatus());useEffect(()=>{const f=()=>setPersistent(storageStatus());addEventListener('preview-state',f);return()=>removeEventListener('preview-state',f)},[]);return <aside className="preview-strip" aria-label="草稿預覽控制"><div className="preview-title"><strong>行光道場 · 草稿操作預覽</strong><small>PR #114 · 2026.11.05</small></div><p>使用示例與本機模擬資料；不連接正式資料庫，也不會自動呼叫 AI 或發布。</p><nav className="preview-tools"><Link className={realm==='weaving'?'is-current':''} href="/weaving">織光堂</Link><Link className={realm==='liaojie'?'is-current':''} href="/liaojie">聊解室</Link><Link href={'/'+realm+'/works/'+demoWork()}>試單篇流程</Link><Link href={'/'+realm+'/works/'+demoGraphicWork()}>看圖文搬遷</Link><button onClick={download}>下載預覽備份</button></nav><details><summary>怎麼試這一版</summary><p>本次補上 B 的自然貼回與確認採用、研究候選查找、多平台規範及等寬選項。從「帶草稿進 B」開始，可先複選 IG／Threads／噗浪，再複製指令。貼回結果後按「採用 B 為可編寫稿」開啟預覽，檢查候選文章再確認；純文章沒有標題也可手動帶入。研究候選由本人決定用途，平台稿分開保存。前輪素材直送 A／B、作者與 AI 分開、舊資料接續、過期提示及雙場域返回都保留。接著可試 C 的轉製／擴寫、預覽完稿、D 延伸及準備發布。完整指令可複製到 ChatGPT，回覆貼回各自欄位。可在 A／B 打開「選行光剪藏、閱讀或野採素材加入本件作品」。測試舊資料時，先下載下方範例，再由同場域匯入頁預覽並套用；重複預覽會顯示接續同件。</p><p>示例文字是虛構資料。正式保存、權限與網路失敗等後端行為，仍須在線上版本驗收。舊五工具保留自己的草稿備份按鈕。</p><div className="preview-tools"><Link href={'/'+realm+'/import'}>匯入舊測試版 JSON</Link><Link href={'/'+realm+'/topics'}>主題與方向</Link><Link href={'/'+realm+'/voice'}>語氣設定</Link><button onClick={()=>{const a=document.createElement('a'),u=URL.createObjectURL(new Blob([JSON.stringify(migrationExample(),null,2)],{type:'application/json'}));a.href=u;a.download='lumen-five-gaps-example.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),30000)}}>下載舊資料測試範例</button><button onClick={()=>{failNextSave();setNotice('下一次保存會模擬失敗。輸入會保留，再按保存即可重試。')}}>試一次保存失敗</button><button className="reset" onClick={()=>{if(confirm('重置這份 HTML 的原生示例資料？建議先下載預覽備份。')){resetDemo();setNotice('已重新建立示例。')}}}>重置示例</button></div><label>載回這份 HTML 的預覽備份<input type="file" accept=".json,application/json" onChange={async e=>{const f=e.target.files?.[0];if(!f)return;try{const p=JSON.parse(await f.text());if(!confirm('用這份預覽備份取代目前模擬資料？'))return;replaceSnapshot(p);setNotice('預覽備份已載回。');navigate('/weaving/works?restored='+Date.now())}catch(e){setNotice(String(e))}}}/></label></details>{!persistent&&<p role="alert">目前瀏覽器不允許持久保存，或儲存空間已滿。請下載預覽備份，避免關閉後遺失。</p>}{notice&&<p role="status">{notice}</p>}</aside>}
function Home({realm}:{realm:'weaving'|'liaojie'}){return <div className="screen"><header className="preview-home-hero"><CreativeHeroArt realm={realm}/><span className="eyebrow">行光道場</span><h1>{realm==='weaving'?'織光堂':'聊解室'}</h1><p>{realm==='weaving'?'把閱讀與生活裡的體會，寫成一件有自己觀點的作品。':'接住完成的作品，安排發布、活動與每人的服務。'}</p></header><StudioHome realm={realm}/></div>}
function Scope({path,realm}:{path:string;realm:string}){const names:any={'/':'今天','/calendar':'行事曆','/bingo':'週盤','/review':'回看','/forage':'野採素材','/weaving/sources':'正式來源設定','/weaving/proposals':'點點的提案','/liaojie/services':'活動與私人交付','/weaving/video':'短影音','/weaving/podcast':'Podcast','/weaving/comic':'漫畫','/weaving/long-video':'長影片'};return <section className="screen studio"><h1>{names[path]||'其他工作端'}</h1><section className="preview-explainer"><p>這份 HTML 先供你核對本次修改的文章協作、作品版本、舊資料及圖文流程。此頁沿用既有正式工作端，未加入這份檔案的離線模擬。</p><Link href={'/'+realm}>回到{realm==='weaving'?'織光堂':'聊解室'}</Link><Link href={'/'+realm+'/works'}>接續作品</Link><Link href={'/'+realm+'/tools'}>創作工具</Link></section></section>}
function Main({path,query,realm}:{path:string;query:URLSearchParams;realm:'weaving'|'liaojie'}){
 if(path==='/weaving'||path==='/liaojie')return <Home realm={realm}/>;
 if(/^\/(weaving|liaojie)\/works$/.test(path))return <StudioManager realm={realm}/>;
 if(/^\/(weaving|liaojie)\/works\/[^/]+$/.test(path))return <StudioWorkspace id={path.split('/').at(-1)!} realm={realm} startInWriting={query.get('entry')==='write'}/>;
 if(path.endsWith('/topics'))return <StudioTopics realm={realm}/>;
 if(path.endsWith('/import'))return <StudioImport realm={realm}/>;
 if(path.endsWith('/sources'))return <SourceSettingsWorkspace realm={realm}/>;
 if(path.endsWith('/voice'))return <StudioVoice realm={realm}/>;
 if(path.endsWith('/illustrated'))return <IllustratedWorkspace completionId={query.get('completionId')} deckId={query.get('deckId')} realm={realm}/>;
 if(/^\/(weaving|liaojie)\/tools$/.test(path))return <ToolHub realm={realm}/>;
 if(/^\/(weaving|liaojie)\/tools\//.test(path)){const key=path.split('/').at(-1)!,tool=originalTool(key);if(tool){const original=(window as any).__LEGACY_TOOLS__[key],theme=realm==='weaving'?':root{--bg:#FCF5FB;--surface-2:#F8E7F4;--muted:#58677C;--sub:#58677C;--line:#EBDDEC;--border:#EBDDEC;--accent:#8B3F68;--primary:#8B3F68;--primary-hover:#713254;--gold:#8B3F68;--green:#8B3F68;--green-dark:#713254;--green-soft:#F8E7F4;--cream:#F8E7F4;}':'',html=original.replace('</head>','<style>'+theme+'</style></head>');return <OriginalToolWorkspace key={realm+key} tool={key} name={tool.name} html={html} bridge={(window as any).__LEGACY_BRIDGE__} realm={realm}/>}}
 if(path==='/liaojie/sanko')return <section className="screen studio"><h1>日上三更｜占卜內容製作</h1><p>八種創作方法沿用原有名稱與設計。</p><div className="studio-link-grid"><Link href="/liaojie/tools/sanko-prompt">製作單篇占卜貼文</Link><Link href="/liaojie/tools/sanko-batch">規劃多天的占卜貼文</Link><Link href="/liaojie/works">編輯文章與圖文</Link></div></section>;
 if(path==='/liaojie/workbench'||path==='/liaojie/plurk'||path==='/weaving/plurk'||path==='/plurk')return <LiaojiePublicationWorkbench initialId={query.get('id')}/>;
 if(path==='/liaojie/releases')return <ReleaseHistory/>;
 if(path.endsWith('/legacy'))return <ToolHub realm={realm}/>;
 if(path==='/map')return <section className="screen studio"><h1>選擇場域</h1><div className="studio-link-grid"><Link href="/weaving">織光堂</Link><Link href="/liaojie">聊解室</Link></div></section>;
 if(path==='/add')return <StudioManager realm={realm}/>;
 return <Scope path={path} realm={realm}/>;
}
function NavIcon({name}:{name:string}){return <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{name==='sun'?<><circle cx="12" cy="12" r="3.5"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/></>:name==='calendar'?<><rect x="3.5" y="5" width="17" height="15" rx="2.5"/><path d="M7.5 3v4M16.5 3v4M3.5 9.5h17M8 13h.01M12 13h.01M16 13h.01M8 16.5h.01M12 16.5h.01M16 16.5h.01"/></>:name==='add'?<><circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/></>:name==='board'?<><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></>:<><path d="M4.8 7.2V3.8M4.8 7.2h3.4M5 7a8.5 8.5 0 1 1-1.1 8"/><path d="M12 7.5V12l3 2"/></>}</svg>}
function App(){const path=usePathname(),query=useSearchParams(),realm=path.startsWith('/liaojie')?'liaojie':'weaving';return <><Toolbar realm={realm}/><div className={'dojo creative-shell creative-'+realm}><main className="app"><header className="top"><button className="backbtn" onClick={()=>navigate('/'+realm)}>‹ {realm==='weaving'?'織光堂':'聊解室'}</button><div className="top-actions"><button onClick={()=>navigate('/timer')}><CreativeIcon name="clock"/> 計時</button><button onClick={()=>navigate('/map')}><CreativeIcon name="grid"/> 場域</button></div></header><div id="view"><Boundary key={path+query.toString()}><Main key={path+query.toString()} path={path} query={query} realm={realm}/></Boundary></div></main><nav className="nav" aria-label="主要導覽">{[['sun','今天','/'],['calendar','行事曆','/calendar'],['add','新增','/add'],['board','週盤','/bingo'],['history','回看','/review']].map(([icon,label,href])=><button key={label} onClick={()=>navigate(href)} aria-current={path===href?'page':undefined} data-nav={icon==='add'?'add':icon}><span className="nav-icon"><NavIcon name={icon}/></span>{label}</button>)}</nav></div></>}
(window as any).__PREVIEW__={snapshot,fullBackup};
createRoot(document.getElementById('root')!).render(<App/>);
